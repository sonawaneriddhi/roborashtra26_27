# ─────────────────────────────────────────────────────────────────────────────
# Roborashtra – Environment Variables Example
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Cloudinary (REQUIRED for image delivery) ──────────────────────────────────
# Your Cloudinary cloud name (visible in your Cloudinary dashboard)
# Safe to expose client-side — only the cloud name, never secrets.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# ── Cloudinary Upload API (SERVER-SIDE ONLY — never expose to client) ─────────
# Used exclusively by the POST /api/upload server route for signed uploads.
# Find these in your Cloudinary dashboard under Settings > API Keys.
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Admin Access Credentials (SERVER-SIDE ONLY — safe in .env.local) ──────────
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password
# Copy to .env.local (or .env) and fill in your own values.

# ── Cloudinary (image delivery) ─────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Server-only (signed uploads; not used by the static deployment)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── MongoDB Atlas (Node server only) ────────────────────────
MONGODB_URI=
MONGODB_DB_NAME=roborashtra

# ── Client-side access gates ────────────────────────────────
# WARNING: NEXT_PUBLIC_* values are bundled into the browser build.
# These gates are conveniences, not real authentication.
NEXT_PUBLIC_ADMIN_PIN=2027
NEXT_PUBLIC_JUDGE_PIN=judge
